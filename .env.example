# Local SQLite is used when DATABASE_URL is omitted.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/plumber_uber
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PLATFORM_COMMISSION_BPS=1500
DISPATCH_RADIUS_KM=20