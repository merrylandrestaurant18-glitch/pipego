# Copy these variable names and values into Railway > API service > Variables.
# Replace every placeholder before deploying. Railway supplies PORT automatically.
ENVIRONMENT=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
SECRET_KEY=generate-a-unique-random-secret-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=generate-a-different-unique-random-secret-at-least-32-characters
CORS_ORIGINS=https://your-vercel-domain.vercel.app

# Optional settings; these match the application defaults.
ACCESS_TOKEN_MINUTES=15
PLATFORM_COMMISSION_BPS=1500
DISPATCH_RADIUS_KM=20
